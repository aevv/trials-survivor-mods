<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TSMods.Loader.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="OkBrush" Color="#4CAF7A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E0A33A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#E0564B" />
    <SolidColorBrush x:Key="UnknownBrush" Color="#8A8F98" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1E2126" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2E333A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263B52" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{StaticResource UnknownBrush}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#101214" />
    </Style>
    <Style Selector="Border.badge.ok">
      <Setter Property="Background" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="Border.badge.warn">
      <Setter Property="Background" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="Border.badge.error">
      <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
    </Style>

    <Style Selector="Border.banner">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="#3A2F1A" />
      <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.banner.error">
      <Setter Property="Background" Value="#3A1F1D" />
      <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style Selector="TextBlock.status.error">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
  </Application.Styles>

</Application>
