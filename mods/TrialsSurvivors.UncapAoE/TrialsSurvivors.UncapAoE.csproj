<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TrialsSurvivors.UncapAoE</AssemblyName>
    <Version>0.2.1</Version>
    <Description>Removes the cap on how many enemies one area attack can hit, so a big explosion hits the whole screen. Skills that fire a projectile per target stay capped so they don't flood the screen.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InteropReference Include="Il2CppSystem.Core" />
  </ItemGroup>

</Project>
